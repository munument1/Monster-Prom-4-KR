    {
      "line": 262,
      "event": "cdate_zoe_3",
      "english_sha256": "642222e7562c6a2fed9fd529f358842df28c2686606444b4e609a0df275dfd6f",
      "ko": "그렇지?!"
    },
    {
      "line": 263,
      "event": "cdate_zoe_3",
      "english_sha256": "030e06e7fac13e443f9c0ac4e0d8414c58a6488bd8118fd41395dcc96d110427",
      "ko": "지금 두 번째 단계로 곧 넘어가는 건 리암과 나뿐이야. 나머지는 계속 모임에 나와 믿을 만하다는 걸 증명해야 해."
    },
    {
      "line": 264,
      "event": "cdate_zoe_3",
      "english_sha256": "f6a7c6debbd680fd297dc280559d70bf11520e1c593723107265fdfae5481487",
      "ko": "우등생이네!"
    },
    {
      "line": 265,
      "event": "cdate_zoe_3",
      "english_sha256": "a28351a109c8b955c1511930b41f898e9aaf36033215977fdafdc4e9a2893ba9",
      "ko": "당연하지! 갱생 서사 프로그램에서 수석이라고!"
